# 多阶段构建 - 构建frontend
FROM node:20.11.1-alpine3.19 as frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

# 构建backend
FROM golang:1.22.1-alpine3.19 AS backend-builder
WORKDIR /app
COPY backend/go.* ./
ENV GOPROXY=https://goproxy.cn,direct
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -o main .

# 最终运行镜像
FROM nginx:1.25.4-alpine

# 安装supervisor用于管理多个进程
RUN apk add --no-cache supervisor

# 复制frontend构建结果
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# 复制backend二进制文件
COPY --from=backend-builder /app/main /usr/local/bin/backend
RUN chmod +x /usr/local/bin/backend

# 复制nginx配置
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# 创建supervisor配置
RUN mkdir -p /etc/supervisor/conf.d
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
user=root

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:backend]
command=/usr/local/bin/backend
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=GIN_MODE=release,REDIS_HOST=redis-service,REDIS_PORT=6379,REDIS_PASSWORD="",REDIS_DB=0,PORT=8080
EOF

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]






